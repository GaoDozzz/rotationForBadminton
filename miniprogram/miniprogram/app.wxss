page {
  background: #f5f7f6;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
}

.primary-button {
  color: #ffffff;
  background: #16a66a;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

