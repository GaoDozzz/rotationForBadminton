<view class="page" wx:if="{{draft}}"><view class="card"><view class="draft-badge">草稿</view><view class="title">{{draft.title}}</view><view class="meta">{{formatLabel}} · {{registrationLabel}}</view><view class="stats"><view><text class="value">{{draft.registrationMode === 'ORGANIZER_MANAGED' ? draft.manualParticipants.length : draft.capacity}}</text><text class="unit"> 人</text></view><view><text class="value">{{draft.courtCount}}</text><text class="unit"> 场地</text></view><view><text class="value">{{draft.rounds}}</text><text class="unit"> 轮</text></view><view><text class="value">{{draft.scoreTo}}</text><text class="unit"> 分</text></view></view><view wx:if="{{draft.registrationMode === 'ORGANIZER_MANAGED'}}" class="note">组织者录入模式发布后将直接生成对阵并进入进行中，不显示“报名中”。</view><view wx:if="{{offlineMode && draft.registrationMode === 'WECHAT_SELF_SERVICE'}}" class="note">离线模式无法发布微信自主报名球局，请先继续编辑并改为组织者录入。</view></view><view class="actions"><button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="publishDraft">{{offlineMode && draft.registrationMode === 'WECHAT_SELF_SERVICE' ? '离线模式不可发布' : draft.registrationMode === 'ORGANIZER_MANAGED' ? '直接开始球局' : '发布报名球局'}}</button><button class="secondary-button" disabled="{{submitting}}" bindtap="editDraft">继续编辑</button><button class="danger-button" disabled="{{submitting}}" bindtap="deleteCurrentDraft">删除草稿</button></view></view>
