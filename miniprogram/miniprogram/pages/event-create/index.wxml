<view class="page create-page">
  <view wx:if="{{draftLimitReached && !draftId}}" class="limit-banner">草稿已满：仍可直接发起球局；如需保存，请先删除或编辑已有草稿。</view>
  <view wx:if="{{offlineMode}}" class="offline-notice">离线模式：仅支持组织者录入。创建的球局和草稿变更将在退出离线模式时清除。</view>
  <view class="card form-card">
    <view class="field"><view class="label">球局名称</view><input class="input" maxlength="40" placeholder="例如：周五晚自由转" value="{{title}}" bindinput="onTitleInput" /></view>
    <view class="field"><view class="label">比赛说明 <text class="optional">选填</text></view><textarea class="description" maxlength="500" auto-height placeholder="时间、地点、水平要求或其他注意事项" value="{{description}}" bindinput="onDescriptionInput" /><view class="count-hint">{{description.length}} / 500</view></view>
    <view class="field"><view class="label">比赛形式</view><view class="option-grid"><view class="option-card {{matchFormat === 'SINGLES' ? 'active' : ''}}" data-format="SINGLES" bindtap="selectFormat"><view class="option-title">单打</view><view class="option-description">每场 2 人 · 1 对 1</view></view><view class="option-card {{matchFormat === 'DOUBLES' ? 'active' : ''}}" data-format="DOUBLES" bindtap="selectFormat"><view class="option-title">双打</view><view class="option-description">每场 4 人 · 自由搭档</view></view><view class="option-card mixed-option {{matchFormat === 'MIXED_DOUBLES' ? 'active' : ''}}" data-format="MIXED_DOUBLES" bindtap="selectFormat"><view class="option-title">双打混双</view><view class="option-description">男女搭档 · 男女对战</view></view></view></view>
    <view class="field"><view class="label">报名模式</view><view class="option-grid"><view class="option-card {{registrationMode === 'WECHAT_SELF_SERVICE' ? 'active' : ''}} {{offlineMode ? 'disabled-option' : ''}}" data-mode="WECHAT_SELF_SERVICE" bindtap="selectRegistrationMode"><view class="option-title">微信自主报名</view><view class="option-description">{{offlineMode ? '离线模式不可用' : '发起后进入报名中'}}</view></view><view class="option-card {{registrationMode === 'ORGANIZER_MANAGED' ? 'active' : ''}}" data-mode="ORGANIZER_MANAGED" bindtap="selectRegistrationMode"><view class="option-title">组织者录入</view><view class="option-description">录完直接生成对阵</view></view></view></view>
    <view class="field"><view class="label">比赛设置</view><view class="picker-grid"><picker wx:if="{{registrationMode === 'WECHAT_SELF_SERVICE'}}" mode="selector" range="{{capacityOptions}}" value="{{capacityIndex}}" bindchange="onCapacityChange"><view class="picker-card"><view class="picker-label">人数上限</view><view class="picker-value">{{capacity}} 人 ›</view></view></picker><view wx:else class="picker-card derived"><view class="picker-label">已录人数</view><view class="picker-value">{{manualParticipants.length}} 人</view></view><picker mode="selector" range="{{courtOptions}}" value="{{courtIndex}}" bindchange="onCourtChange"><view class="picker-card"><view class="picker-label">场地</view><view class="picker-value">{{courtCount}} 块 ›</view></view></picker><picker mode="selector" range="{{scoreOptions}}" value="{{scoreIndex}}" bindchange="onScoreChange"><view class="picker-card"><view class="picker-label">分制</view><view class="picker-value">{{scoreTo}} 分 ›</view></view></picker><picker mode="selector" range="{{roundOptions}}" value="{{roundIndex}}" bindchange="onRoundChange"><view class="picker-card"><view class="picker-label">轮数（默认 {{recommendedRounds}}）</view><view class="picker-value">{{rounds}} 轮 ›</view></view></picker></view></view>
    <view wx:if="{{registrationMode === 'ORGANIZER_MANAGED'}}" class="manual-section"><view wx:if="{{matchFormat === 'MIXED_DOUBLES'}}" class="mixed-hint">混双要求男女人数相等；系统只生成“一男一女”搭档之间的对阵。</view><view class="section-heading"><view class="label">录入参赛者</view><view class="count">已录入 {{manualParticipants.length}} 人</view></view><view class="manual-input-row"><input class="input compact-input" type="number" maxlength="6" placeholder="编号" value="{{manualNumber}}" bindinput="onManualNumberInput" /><input class="input compact-input" maxlength="20" placeholder="昵称（不可重复）" value="{{manualNickname}}" bindinput="onManualNicknameInput" /></view><picker mode="selector" range="{{levelOptions}}" value="{{manualLevelIndex}}" bindchange="onLevelChange"><view class="input level-picker">{{manualLevel || '水平（选填）'}} ›</view></picker><view class="gender-row"><view class="gender-label">性别</view><view class="gender-option {{manualGender === 'MALE' ? 'active' : ''}}" data-gender="MALE" bindtap="selectManualGender">男</view><view class="gender-option {{manualGender === 'FEMALE' ? 'active' : ''}}" data-gender="FEMALE" bindtap="selectManualGender">女</view><button class="add-button" bindtap="addManualParticipant">添加</button></view><view wx:if="{{manualParticipants.length === 0}}" class="manual-empty">编号从 1 自动生成，也可以修改为其他正整数</view><view wx:for="{{manualParticipants}}" wx:key="localId" class="participant-row"><input class="number-editor" type="number" maxlength="6" value="{{item.participantNumber}}" data-id="{{item.localId}}" bindblur="onParticipantNumberBlur" /><view class="participant-info"><view class="participant-name">{{item.nickname}} · {{item.gender === 'MALE' ? '男' : '女'}}</view><view wx:if="{{item.level}}" class="participant-level">{{item.level}}</view></view><view class="remove-action" data-id="{{item.localId}}" bindtap="removeManualParticipant">移除</view></view></view>
  </view>
  <view class="bottom-panel"><view class="summary">{{matchFormat === 'SINGLES' ? '单打' : matchFormat === 'MIXED_DOUBLES' ? '双打混双' : '双打'}} · {{registrationMode === 'ORGANIZER_MANAGED' ? manualParticipants.length : capacity}} 人 · {{courtCount}} 场地 · {{rounds}} 轮 · {{scoreTo}} 分</view><block wx:if="{{draftId}}"><view class="action-row"><button class="update-button" disabled="{{submitting}}" bindtap="saveCurrentDraft">更新草稿</button><button class="cancel-button" disabled="{{submitting}}" bindtap="cancelChanges">取消变更</button></view><button class="primary-button full-start" loading="{{submitting}}" disabled="{{submitting}}" bindtap="startCurrentEvent">开始球局</button></block><view wx:else class="action-row"><button class="secondary-button" disabled="{{submitting || draftLimitReached}}" bindtap="saveCurrentDraft">保存草稿</button><button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="startCurrentEvent">{{registrationMode === 'ORGANIZER_MANAGED' ? '直接开始球局' : '发起报名球局'}}</button></view></view>
</view>

