/* 画布逻辑尺寸固定，避免窄屏设备把 375px 海报裁切。 */
.poster-canvas{width:375px;height:880px}
/* 详情页操作区：筛选保持右下角圆形，分享居中且与其等高。 */
.manage-button{display:flex;align-items:center;width:100%;min-height:116rpx;margin:24rpx 0 0;padding:22rpx 24rpx;text-align:left;color:#1d2939;background:linear-gradient(135deg,#f1fbf6,#e5f7ee);border:2rpx solid #c8ebda;border-radius:24rpx;box-shadow:0 6rpx 18rpx rgba(13,143,98,.07)}
.manage-icon{display:flex;flex:0 0 62rpx;width:62rpx;height:62rpx;align-items:center;justify-content:center;margin-right:18rpx;border-radius:20rpx;color:#fff;background:#16a66a;font-size:26rpx;font-weight:700}
.manage-copy{flex:1;min-width:0}.manage-title{color:#087a4b;font-size:29rpx;font-weight:700}.manage-subtitle{margin-top:7rpx;color:#667085;font-size:21rpx;line-height:1.45;white-space:normal}.manage-arrow{padding-left:14rpx;color:#16a66a;font-size:42rpx;font-weight:300}
.floating-actions{position:fixed;left:0;right:0;bottom:calc(34rpx + env(safe-area-inset-bottom));z-index:20;height:82rpx;pointer-events:none}
.float-button{display:flex;height:82rpx;align-items:center;justify-content:center;margin:0;padding:0;box-shadow:0 9rpx 26rpx rgba(31,41,55,.2);pointer-events:auto}
.filter-button{position:absolute;right:28rpx;bottom:0;width:82rpx;border-radius:50%;color:#fff;background:#16a66a;font-size:24rpx}
.share-button{position:absolute;left:50%;bottom:0;width:224rpx;transform:translateX(-50%);border:2rpx solid #b9e6d0;border-radius:41rpx;color:#087a4b;background:rgba(255,255,255,.96);font-size:25rpx}
.winner-score{color:#0d8f62;font-size:inherit;font-weight:400;text-shadow:none}
.ranking-actions{display:flex;justify-content:flex-end;margin-bottom:18rpx}.share-ranking{width:auto;min-width:190rpx;height:72rpx;margin:0;padding:0 30rpx;border:2rpx solid #b9e6d0;border-radius:36rpx;color:#087a4b;background:#f0faf5;font-size:25rpx}



/* 对阵管理、状态 Badge 与单选人员面板。 */
.preview-status{display:inline-flex;align-items:center;min-height:38rpx;padding:0 14rpx;border-radius:19rpx;font-size:20rpx;font-weight:600;line-height:38rpx}
.preview-status.pending{color:#59636e;background:#edf0f2}.preview-status.live{color:#a14f00;background:#fff0d7}.preview-status.finished{color:#087a4b;background:#e2f6ec}.preview-status.warning{color:#a15c00;background:#fff4ce}.preview-status.neutral{color:#667085;background:#f2f4f3}
.floating-actions{left:0;right:0;height:76rpx;pointer-events:none}
.float-button{min-width:0;pointer-events:auto}.float-button::after{border:0}
.filter-button,.match-manage-button{position:absolute;bottom:4rpx;width:68rpx;height:68rpx;border-radius:50%;font-size:21rpx;box-shadow:0 7rpx 20rpx rgba(31,41,55,.18)}
.filter-button{right:24rpx;color:#fff;background:#287d7a}.match-manage-button{left:24rpx;color:#8a5200;background:#fff0cf;border:2rpx solid #edcc83}
.share-button{bottom:0;width:210rpx;height:76rpx;border-radius:38rpx;box-shadow:0 8rpx 22rpx rgba(31,41,55,.16)}
.filter-badge{right:-3rpx;top:-8rpx;width:30rpx;height:30rpx;border:2rpx solid #fff;border-radius:16rpx;background:#344054;font-size:17rpx}
.lineup-slot-radio{padding:20rpx 0;border-bottom:2rpx solid #eef1f0}.lineup-slot-title{margin-bottom:14rpx;color:#344054;font-size:24rpx;font-weight:700}
.lineup-radio-group{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;max-height:300rpx;overflow-y:auto}
.lineup-radio-option{display:flex;align-items:center;min-width:0;padding:14rpx 12rpx;border:2rpx solid #e4e7e7;border-radius:14rpx;color:#475467;background:#f8faf9;font-size:22rpx}
.lineup-radio-option.active{color:#087a4b;border-color:#7fd0aa;background:#eaf8f1}.lineup-radio-option.disabled{opacity:.62}.lineup-radio{transform:scale(.78);transform-origin:left center}
.lineup-radio-option>text:nth-of-type(1){flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.lineup-gender{margin-left:8rpx;color:#98a2b3;font-size:19rpx}



/* 独立悬浮组件、紧凑选人入口与退出人员状态。 */
.ranking-actions{display:flex;justify-content:flex-end}.share-ranking{display:inline-flex;width:190rpx;height:72rpx;align-items:center;justify-content:center;box-sizing:border-box;padding:0;border:2rpx solid #b9e6d0;border-radius:36rpx;color:#087a4b;background:#f0faf5;font-size:25rpx;line-height:1}
.floating-actions{display:block;left:0;right:0;height:72rpx;pointer-events:none}
.float-action{position:absolute;display:flex;align-items:center;justify-content:center;box-sizing:border-box;pointer-events:auto;user-select:none}
.manage-action,.filter-action{bottom:4rpx;width:64rpx;height:64rpx;border-radius:32rpx;font-size:21rpx;box-shadow:0 7rpx 20rpx rgba(31,41,55,.17)}
.manage-action{left:24rpx;color:#8a5200;background:#fff0cf;border:2rpx solid #edcc83}.manage-action.disabled{opacity:.55}
.filter-action{right:24rpx;color:#fff;background:#287d7a}.share-action{left:50%;bottom:0;width:200rpx;height:72rpx;transform:translateX(-50%);border:2rpx solid #b9e6d0;border-radius:36rpx;color:#087a4b;background:#fff;font-size:25rpx;box-shadow:0 8rpx 22rpx rgba(31,41,55,.15)}
.filter-action .filter-badge{display:flex;align-items:center;justify-content:center;box-sizing:border-box}
.participant.withdrawn{color:#98a2b3;background:#f7f8f8}.participant.withdrawn .number,.participant.withdrawn .points,.participant.withdrawn .level{color:#a8afb8}.participant-name-line{display:flex;align-items:center;gap:12rpx}.withdrawn-badge{display:inline-flex;align-items:center;height:32rpx;padding:0 10rpx;border-radius:16rpx;color:#667085;background:#e4e7ec;font-size:18rpx}
.lineup-current-row{display:flex;align-items:center;justify-content:space-between;min-height:94rpx;padding:10rpx 8rpx;border-bottom:2rpx solid #eef1f0}.lineup-current-row.editable{background:#fbfefc}.lineup-current-name{margin-top:7rpx;color:#344054;font-size:25rpx}.lineup-chevron{color:#16a66a;font-size:22rpx}
.lineup-selector-mask{z-index:130}.lineup-selector-panel{max-height:78vh}.selector-tip{margin:12rpx 0 22rpx;text-align:center;color:#98a2b3;font-size:21rpx}.lineup-choice-list{overflow-y:auto;max-height:52vh}.lineup-choice{display:flex;align-items:center;justify-content:space-between;min-height:88rpx;padding:10rpx 18rpx;border-bottom:2rpx solid #eef1f0}.lineup-choice.selected{border-radius:14rpx;color:#087a4b;background:#eaf8f1}.choice-name{font-size:26rpx;font-weight:600}.choice-meta{margin-top:5rpx;color:#98a2b3;font-size:21rpx}.choice-check{color:#16a66a;font-size:32rpx;font-weight:700}.selector-cancel{height:76rpx;margin-top:20rpx;border-radius:18rpx;text-align:center;color:#667085;background:#edf0ef;font-size:25rpx;line-height:76rpx}
