.home{padding-top:48rpx}.hero,.card-top{display:flex;align-items:center}.hero{margin-bottom:36rpx}.brand-mark{width:96rpx;height:96rpx;line-height:96rpx;border-radius:48rpx;text-align:center;color:#fff;background:#16a66a;font-size:42rpx;font-weight:700}.hero-copy{margin-left:24rpx}.title{font-size:44rpx;font-weight:700}.subtitle,.card-meta,.empty-description{color:#667085;margin-top:8rpx}.create-button{margin-bottom:24rpx}.limit-banner{padding:20rpx 24rpx;border-radius:16rpx;color:#8a5200;background:#fff3d6;font-size:24rpx}.filters{margin:28rpx 0 8rpx;white-space:nowrap}.filter-row{display:inline-flex;gap:16rpx}.filter{padding:14rpx 24rpx;border-radius:32rpx;color:#667085;background:#edf0ef;font-size:24rpx}.filter.active{color:#fff;background:#16a66a}.section{margin-top:32rpx}.section-title{margin-bottom:16rpx;font-size:32rpx;font-weight:600}.swipe-row{position:relative;overflow:hidden;border-radius:20rpx}.swipe-row+.swipe-row{margin-top:20rpx}.row-actions{position:absolute;top:0;right:-4rpx;bottom:0;width:244rpx;display:flex;justify-content:flex-end}.row-actions.single{width:124rpx}.row-actions view{width:120rpx;display:flex;align-items:center;justify-content:center;color:#fff}.edit-action{background:#3b82f6}.delete-action{background:#e5484d}.swipe-content{position:relative;z-index:1;width:100%;margin:0;box-sizing:border-box;background:#fff;transition:transform .18s ease}.swipe-content.opened{transform:translateX(-240rpx)}.swipe-content.opened.single{transform:translateX(-120rpx)}.card-top{justify-content:space-between}.status{font-size:24rpx;font-weight:600}.status.progress{color:#e05a00}.status.registration{color:#16a66a}.status.draft{color:#b36b00}.status.finished{color:#667085}.arrow{color:#98a2b3;font-size:40rpx}.card-title{margin-top:12rpx;font-size:32rpx;font-weight:600}.card-meta{font-size:24rpx}.empty-card{text-align:center;padding:56rpx 36rpx}.empty-title{font-size:32rpx;font-weight:600}.empty-description{line-height:1.6}.server-status{margin-top:40rpx;te