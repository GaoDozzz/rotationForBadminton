<view class="page"><view class="toolbar"><view class="filters"><view class="filter {{activeFilter === 'ALL' ? 'active' : ''}}" data-filter="ALL" bindtap="selectFilter">全部</view><view class="filter {{activeFilter === 'PENDING' ? 'active' : ''}}" data-filter="PENDING" bindtap="selectFilter">待完成</view><view class="filter {{activeFilter === 'LIVE' ? 'active' : ''}}" data-filter="LIVE" bindtap="selectFilter">比赛中</view><view class="filter {{activeFilter === 'FINISHED' ? 'active' : ''}}" data-filter="FINISHED" bindtap="selectFilter">已结束</view></view><button class="share-button" size="mini" bindtap="shareMatches">生成分享</button></view><view wx:if="{{!loading && roundGroups.length === 0}}" class="card empty">当前筛选下没有对阵</view><view wx:for="{{roundGroups}}" wx:key="roundNumber" class="round-section"><view class="round-head"><view><text class="round-index">R{{item.roundNumber}}</text><text class="round-title">第 {{item.roundNumber}} 轮</text></view><text class="round-progress">{{item.completedCount}} / {{item.matches.length}} 完成</text></view><view wx:for="{{item.matches}}" wx:for-item="match" wx:key="id" class="card match-card"><view class="match-head"><text>{{match.courtNumber}} 号场地</text><text class="status status-{{match.status}}">{{match.statusLabel}}</text></view><view class="teams"><view class="team"><text class="side">A</text><text>{{match.teamAName}}</text></view><view class="score"><text class="{{match.winner === 'A' ? 'winner-score' : ''}}">{{match.displayAScore}}</text><text class="colon">:</text><text class="{{match.winner === 'B' ? 'winner-score' : ''}}">{{match.displayBScore}}</text></view><view class="team right"><text>{{match.teamBName}}</text><text class="side side-b">B</text></view></view><view wx:if="{{editingMatchId === match.id}}" class="score-editor"><picker mode="multiSelector" range="{{scoreColumns}}" value="{{scorePickerValue}}" bindchange="onScorePickerChange"><view class="score-wheel"><text>{{scorePickerValue[0]}}</text><text>:</text><text>{{scorePickerValue[1]}}</text><view class="wheel-tip">点击滚轮选择</view></view></picker><view class="editor-actions"><button size="mini" class="save-score" loading="{{saving}}" bindtap="saveScore">保存</button><button size="mini" class="reset-score" loading="{{saving}}" bindtap="resetScore">重置</button><button size="mini" class="cancel-score" bindtap="cancelScoreEdit">取消</button></view></view><button wx:else class="edit-score" size="mini" data-id="{{match.id}}" bindtap="editScore">编辑比分</button></view></view><canvas canvas-id="matchesPoster" class="poster-canvas"></canvas></view>
