.toolbar{display:flex;align-items:center;gap:16rpx;margin-bottom:28rpx}.filters{display:flex;flex:1;gap:10rpx}.filter{flex:1;padding:15rpx 4rpx;text-align:center;border-radius:28rpx;color:#667085;background:#edf0ef;font-size:22rpx}.filter.active{color:#fff;background:#16a66a}.share-button{margin:0;padding:0 20rpx;color:#087a4b;background:#e8f7f0;border-radius:28rpx}.round-section+.round-section{margin-top:34rpx}.round-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx;padding:18rpx 22rpx;border-radius:18rpx;color:#fff;background:linear-gradient(120deg,#118d63,#19b777)}.round-index{display:inline-flex;margin-right:14rpx;padding:4rpx 10rpx;border-radius:10rpx;background:rgba(255,255,255,.2);font-size:22rpx}.round-title{font-size:30rpx;font-weight:700}.round-progress{font-size:22rpx;opacity:.9}.match-card+.match-card{margin-top:16rpx}.match-head{display:flex;justify-content:space-between;color:#667085;font-size:24rpx}.status{font-weight:600}.status-IN_PROGRESS{color:#e05a00}.status-COMPLETED,.status-WALKOVER{color:#16a66a}.teams{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16rpx;margin-top:24rpx}.team{display:flex;align-items:center;gap:10rpx;line-height:1.5}.team.right{justify-content:flex-end;text-align:right}.side{display:inline-flex;width:42rpx;height:42rpx;align-items:center;justify-content:center;border-radius:21rpx;color:#fff;background:#16a66a;font-size:22rpx}.side-b{background:#3276e8}.score{display:flex;align-items:center;gap:8rpx;font-size:36rpx;color:#667085}.winner-score{color:#0d8f62;font-size:43rpx;font-weight:800;text-shadow:0 4rpx 10rpx rgba(13,143,98,.16)}.colon{color:#98a2b3}.edit-score{margin:20rpx 0 0 auto;color:#3276e8;background:#edf4ff}.score-editor{margin-top:20rpx;padding-top:18rpx;border-top:2rpx solid #eef1f0}.score-wheel{position:relative;display:flex;height:118rpx;align-items:center;justify-content:center;gap:26rpx;border-radius:18rpx;color:#087a4b;background:#eaf8f1;font-size:48rpx;font-weight:800}.wheel-tip{position:absolute;bottom:6rpx;color:#667085;font-size:18rpx;font-weight:400}.editor-actions{display:flex;justify-content:flex-end;gap:12rpx;margin-top:14rpx}.editor-actions button{margin:0}.save-score{color:#fff;background:#16a66a}.reset-score{color:#b54708;background:#fff1dd}.cancel-score{color:#667085;background:#eef1f3}.empty{text-align:center;color:#667085}.poster-canvas{position:fixed;left:-3000rpx;top:0;width:750rpx;height:1760rpx;pointer-events:none;opacity:.01}
.winner-score{color:#0d8f62;font-size:inherit;font-weight:400;text-shadow:none}

