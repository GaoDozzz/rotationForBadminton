<view class="page"><view wx:if="{{event}}" class="card"><view class="badge">报名中</view><view class="title">{{event.title}}</view><view class="meta">{{event.matchFormat === 'SINGLES' ? '单打' : event.matchFormat === 'MIXED_DOUBLES' ? '双打混双' : '双打'}} · {{event.capacity}} 人 · {{event.courtCount}} 场地 · {{event.rounds}} 轮</view></view><view class="card form"><view class="label">昵称</view><input class="input" maxlength="20" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput"/><view class="label next">性别</view><view class="gender-row"><view class="gender {{gender === 'MALE' ? 'active' : ''}}" data-gender="MALE" bindtap="selectGender">男</view><view class="gender {{gender === 'FEMALE' ? 'active' : ''}}" data-gender="FEMALE" bindtap="selectGender">女</view></view><view class="label next">水平</view><picker mode="selector" range="{{levelOptions}}" value="{{levelIndex}}" bindchange="onLevelChange"><view class="input picker">{{level || '水平（选填）'}} ›</view></picker></view><button class="primary-button" loading="{{submitting}}" disabled="{{submitting || !event}}" bindtap="submitRegistration">确认报名</button></view>


