{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "./miniprogram",
    "outDir": "./miniprogram",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["miniprogram/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts"]
}
