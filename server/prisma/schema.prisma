generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MatchFormat {
  SINGLES
  DOUBLES
  MIXED_DOUBLES
}

enum RegistrationMode {
  WECHAT_SELF_SERVICE
  ORGANIZER_MANAGED
}

enum EventStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  SCHEDULE_READY
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
}

enum ParticipantSource {
  WECHAT_SELF_SERVICE
  ORGANIZER_ENTRY
}

enum ParticipantStatus {
  REGISTERED
  WAITLISTED
  ACTIVE
  WITHDRAWN
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  SCORE_PENDING
  SCORE_DISPUTED
  WALKOVER
  COMPLETED
  CANCELLED
}

enum MatchSide {
  A
  B
}

model User {
  id String @id @default(uuid()) @db.Uuid
  openid String? @unique @db.VarChar(128)
  nickname String @db.VarChar(40)
  gender Gender?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organizedEvents Event[] @relation("EventOrganizer")
  participants Participant[]
  drafts EventDraft[]
  auditLogs AuditLog[] @relation("AuditActor")
  @@map("users")
}

model EventDraft {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  title String @db.VarChar(40)
  matchFormat MatchFormat @map("match_format")
  registrationMode RegistrationMode @map("registration_mode")
  capacity Int?
  courtCount Int @map("court_count")
  scoreTo Int @map("score_to")
  rounds Int
  payload Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("event_drafts")
}

model Event {
  id String @id @default(uuid()) @db.Uuid
  organizerId String @map("organizer_id") @db.Uuid
  title String @db.VarChar(40)
  description String? @db.VarChar(500)
  shareCode String @unique @map("share_code") @db.VarChar(24)
  matchFormat MatchFormat @map("match_format")
  registrationMode RegistrationMode @map("registration_mode")
  status EventStatus
  capacity Int?
  courtCount Int @map("court_count")
  scoreTo Int @map("score_to")
  rounds Int
  scheduleVersion Int @default(0) @map("schedule_version")
  startedAt DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  deletedAt DateTime? @map("deleted_at")
  deletedById String? @map("deleted_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organizer User @relation("EventOrganizer", fields: [organizerId], references: [id])
  participants Participant[]
  matches Match[]
  auditLogs AuditLog[]
  @@index([organizerId, status, updatedAt(sort: Desc)])
  @@index([deletedAt])
  @@map("events")
}

model Participant {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  userId String? @map("user_id") @db.Uuid
  participantNumber String @map("participant_number") @db.VarChar(20)
  nickname String @db.VarChar(20)
  gender Gender
  level String? @db.VarChar(30)
  source ParticipantSource
  status ParticipantStatus @default(ACTIVE)
  joinedAt DateTime @default(now()) @map("joined_at")
  withdrawnAt DateTime? @map("withdrawn_at")
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  matchPlayers MatchPlayer[]
  @@unique([eventId, participantNumber])
  @@unique([eventId, userId])
  @@index([eventId, status])
  @@map("participants")
}

model Match {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  roundNumber Int @map("round_number")
  courtNumber Int @map("court_number")
  scheduleVersion Int @map("schedule_version")
  status MatchStatus @default(SCHEDULED)
  teamAScore Int? @map("team_a_score")
  teamBScore Int? @map("team_b_score")
  resultType String? @map("result_type") @db.VarChar(20)
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  confirmedAt DateTime? @map("confirmed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  players MatchPlayer[]
  @@unique([eventId, scheduleVersion, roundNumber, courtNumber])
  @@index([eventId, status, roundNumber, courtNumber])
  @@map("matches")
}

model MatchPlayer {
  matchId String @map("match_id") @db.Uuid
  participantId String @map("participant_id") @db.Uuid
  side MatchSide
  position Int
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  @@id([matchId, participantId])
  @@unique([matchId, side, position])
  @@index([participantId])
  @@map("match_players")
}

model AuditLog {
  id BigInt @id @default(autoincrement())
  eventId String? @map("event_id") @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  action String @db.VarChar(80)
  entityType String @map("entity_type") @db.VarChar(40)
  entityId String @map("entity_id") @db.VarChar(64)
  before Json?
  after Json?
  createdAt DateTime @default(now()) @map("created_at")
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([eventId, createdAt(sort: Desc)])
  @@map("audit_logs")
}


